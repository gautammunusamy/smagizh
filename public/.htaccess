# Apache / cPanel shared hosting.
# React Router uses real URLs (/categories/bike-rental, /admin/plans, ...), so
# every request that is not a real file must be served index.html.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # The PHP API and uploaded images are served as-is, never rewritten to the SPA.
  RewriteRule ^api/ - [L]
  RewriteRule ^uploads/ - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Long-cache the fingerprinted build assets, never cache the HTML shell.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|svg|woff2|png|jpg|jpeg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
